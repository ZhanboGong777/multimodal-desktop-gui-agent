{
  "schema_version": "week6.semantic_subtasks.v1",
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "semantic_subtask_sequence",
      "strict": true,
      "schema": {
        "$defs": {
          "SemanticGoal": {
            "additionalProperties": false,
            "properties": {
              "instruction": {
                "maxLength": 4000,
                "minLength": 1,
                "title": "Instruction",
                "type": "string"
              },
              "expect_text": {
                "items": {
                  "type": "string"
                },
                "maxItems": 16,
                "title": "Expect Text",
                "type": "array"
              },
              "forbid_text": {
                "items": {
                  "type": "string"
                },
                "maxItems": 16,
                "title": "Forbid Text",
                "type": "array"
              },
              "goal_id": {
                "title": "Goal Id",
                "type": "string"
              }
            },
            "required": [
              "goal_id",
              "instruction",
              "expect_text",
              "forbid_text"
            ],
            "title": "SemanticGoal",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ready",
              "needs_clarification",
              "refused"
            ],
            "title": "Status",
            "type": "string"
          },
          "reason": {
            "maxLength": 4000,
            "title": "Reason",
            "type": "string"
          },
          "subgoals": {
            "items": {
              "$ref": "#/$defs/SemanticGoal"
            },
            "maxItems": 8,
            "title": "Subgoals",
            "type": "array"
          }
        },
        "required": [
          "status",
          "reason",
          "subgoals"
        ],
        "title": "SemanticPlan",
        "type": "object"
      }
    }
  },
  "caller_request": {
    "workflow_id": "semantic_lab",
    "instruction": "In Week6 Local Lab, prepare a GREEN report for project ALPHA, review it and commit it locally. Use the visible controls. This is an offline test with no external communication. If review is temporarily unavailable, retry within budget.",
    "expect_text": [
      "Project ALPHA",
      "Theme GREEN",
      "LOCAL COMPLETE"
    ],
    "forbid_text": []
  },
  "revision": false,
  "postcondition_source": "untrusted_model_semantic_proposal",
  "final_source": "unchanged_caller"
}
