/Document/Week6/results/full_requirements_20261028/** -text -whitespace

# Keep the two CRLF test sources identical to their executed, hash-pinned bytes.
/tests/test_week6_semantic_output_constraints.py -text -whitespace
/tests/test_week6_semantic_text_context.py -text -whitespace
