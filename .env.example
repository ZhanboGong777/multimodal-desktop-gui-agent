# Copy this file to .env and fill in what you need.
#
# Never commit the real .env file: .gitignore already excludes it.
#
# The variable names below are the ones the code actually reads. An earlier
# version of this template listed MODEL_PROVIDER / OPENAI_API_KEY /
# REMOTE_GPU_BASE_URL, none of which the model client looks at - so a correctly
# filled .env still produced "GUI_AGENT_API_KEY is not set".

# ── model backend (src/gui_agent/models/openai_compatible.py) ──────────
# The key is required by every remote backend; any non-empty value works for a
# local Ollama endpoint, which does not check it.
GUI_AGENT_API_KEY=

# Base URL of the OpenAI-compatible endpoint.
#   Local Ollama on this machine : http://127.0.0.1:11434/v1
#   Ollama on the GPU node       : http://<windows-host>:11434/v1
#   A hosted provider            : the provider's own /v1 URL
GUI_AGENT_BASE_URL=

# Model name as the endpoint reports it, e.g. qwen2.5vl:7b
#
# Note the precedence: this variable is a fallback. `ModelConfig.model_name`
# has a non-empty default, so a config file that sets model_name wins over the
# environment. Pass `--model` on the command line to override both.
GUI_AGENT_MODEL=

# ── how the variables are loaded ──────────────────────────────────────
# The code reads the process environment. `load_config` reads YAML, not .env.
# Export the variables, or source this file before running:
#
#   set -a; . ./.env; set +a          # bash / zsh
#   $env:GUI_AGENT_API_KEY = "..."    # PowerShell
